@page
@model PetrolQueueCalculator.Pages.IndexModel
@{
    ViewData["Title"] = "Single-Server Queue Simulator";
}

<!-- App Header -->
<header class="app-header">
  <div class="brand-row">
    <div class="brand-badge"><span class="pump-icon">⛽</span> PETROL STATION QUEUE SIMULATOR</div>
    <div class="version-tag">ASP.NET Core (.NET 8)</div>
  </div>
  <h1><span>Petrol Pump</span> Queue Calculator</h1>
  <p class="header-subtitle">Stochastic single-server performance analyzer verified with empirical Chi-Square goodness-of-fit testing.</p>
</header>

<!-- Top Hero Banner: Empirical Research & Chi-Square Test -->
<section class="research-banner" id="researchBanner">
  <div class="research-content">
    <div class="research-header">
      <span class="research-tag">🔬 STATISTICAL VERIFICATION</span>
      <span class="research-pill badge-rejected">Poisson Rejected (&chi;&sup2; = 19.53, p = 0.0006)</span>
      <span class="research-pill badge-model">Confirmed G/G/1 Model</span>
    </div>
    <p class="research-desc">
      Goodness-of-Fit tested on <strong>Final_Data_Transformed.csv</strong> (300 vehicles over 6 days): Inter-arrival and service distributions show tight clustering (C<sub>a</sub>&sup2; = 0.344, C<sub>s</sub>&sup2; = 0.345) rather than Poisson memorylessness. The station operates under <strong>General Distributions (G/G/1)</strong>.
    </p>
  </div>
  <div class="research-action">
    <button id="loadPresetBtn" type="button" class="preset-btn">
      <span class="btn-icon">⚡</span>
      <span class="btn-text">
        <strong>Load Empirical Data</strong>
        <small>Final_Data_Transformed.csv</small>
      </span>
    </button>
  </div>
</section>

<!-- Two-Column Interactive Layout -->
<div class="layout">
  <!-- Left Column: Input Configuration -->
  <section class="panel input-panel">
    <div class="panel-header">
      <h2>Configuration Parameters</h2>
      <span class="panel-hint">Single Server (c = 1)</span>
    </div>

    <div class="form-group">
      <label for="model">Queueing Model
        <select id="model"></select>
      </label>
    </div>

    <!-- Arrival Card -->
    <div class="sub-panel">
      <div class="sub-panel-title">
        <span class="dot-indicator dot-arr"></span>
        <span id="arrLegend">Arrival Process</span>
      </div>
      <div class="form-row two-col">
        <label>Time unit
          <select id="arrUnit">
            <option value="seconds">Seconds (s)</option>
            <option value="minutes" selected>Minutes (min)</option>
            <option value="hours">Hours (hr)</option>
          </select>
        </label>
        <label>Input type
          <select id="arrType">
            <option value="time">Mean Time</option>
            <option value="rate">Rate (&lambda;)</option>
          </select>
        </label>
      </div>
      <div class="form-row">
        <label><span id="arrValueLabel">Mean inter-arrival time</span>
          <input id="arrValue" type="number" step="any" min="0" placeholder="e.g. 40.15">
        </label>
      </div>
      <div class="form-row" id="arrSdRow">
        <label><span id="arrSdLabel">Standard deviation (&sigma;<sub>a</sub>)</span>
          <input id="arrSd" type="number" step="any" min="0" placeholder="e.g. 23.54">
        </label>
      </div>
    </div>

    <!-- Service Card -->
    <div class="sub-panel">
      <div class="sub-panel-title">
        <span class="dot-indicator dot-svc"></span>
        <span id="svcLegend">Service Process</span>
      </div>
      <div class="form-row two-col">
        <label>Time unit
          <select id="svcUnit">
            <option value="seconds">Seconds (s)</option>
            <option value="minutes" selected>Minutes (min)</option>
            <option value="hours">Hours (hr)</option>
          </select>
        </label>
        <label>Input type
          <select id="svcType">
            <option value="time">Mean Time</option>
            <option value="rate">Rate (&mu;)</option>
          </select>
        </label>
      </div>
      <div class="form-row">
        <label><span id="svcValueLabel">Mean service time</span>
          <input id="svcValue" type="number" step="any" min="0" placeholder="e.g. 39.94">
        </label>
      </div>
      <div class="form-row" id="svcSdRow">
        <label><span id="svcSdLabel">Standard deviation (&sigma;<sub>s</sub>)</span>
          <input id="svcSd" type="number" step="any" min="0" placeholder="e.g. 23.45">
        </label>
      </div>
    </div>

    <div class="form-group">
      <label for="displayUnit">Output Display Unit
        <select id="displayUnit">
          <option value="seconds">Seconds</option>
          <option value="minutes" selected>Minutes</option>
          <option value="hours">Hours</option>
        </select>
      </label>
    </div>

    <div class="buttons">
      <button id="calcBtn" type="button" class="primary-btn">
        <span>Calculate Metrics</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
      <button id="clearBtn" type="button" class="ghost-btn">Clear</button>
    </div>
  </section>

  <!-- Right Column: Results & Performance Insights -->
  <section class="panel result-panel" id="resultPanel">
    <div class="panel-header">
      <h2>Queue Performance Results</h2>
      <span id="systemStatus" class="status-badge status-ready">Ready</span>
    </div>

    <p id="message" class="message">Configure your arrival and service rates on the left and click Calculate, or load the empirical data.</p>

    <!-- Gauge Widget -->
    <div id="gaugeBox" class="gauge-container" hidden>
      <div class="gaugeHead">
        <div class="gauge-title-wrap">
          <span class="gauge-icon">📊</span>
          <span>Pump Utilization (&rho;)</span>
        </div>
        <div class="gauge-val-wrap">
          <strong id="gaugeText">0.0%</strong>
          <span id="gaugeStatusPill" class="gauge-pill pill-ok">Optimal</span>
        </div>
      </div>
      <div class="gauge">
        <div id="gaugeFill"></div>
      </div>
      <div class="gauge-scale">
        <span>0% (Empty)</span>
        <span>50%</span>
        <span>75%</span>
        <span>100% (Saturated)</span>
      </div>
    </div>

    <!-- 6 Clean Result Metric Cards -->
    <div id="cards" class="cards"></div>
  </section>
</div>
